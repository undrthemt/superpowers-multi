{
  "name": "claude-code",
  "description": "Anthropic Claude Code CLI",
  "detect": "which claude",
  "invoke": {
    "command": "claude",
    "args": ["-p", "--output-format", "text"],
    "input_method": "stdin",
    "timeout_seconds": 300
  },
  "invoke_coding": {
    "args": ["-p", "--output-format", "text"],
    "input_method": "stdin",
    "timeout_seconds": 600
  },
  "plugin_override": null,
  "plugin_override_coding": null
}
